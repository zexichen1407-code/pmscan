# ===== Phase 2 实盘配置 (复制成 .env 填写, 只在你本机, 别发给任何人) =====
# ⚠️ 用全新一次性钱包, 只充 ~$11 (10 USDC + ~1 MATIC). 绝不用主钱包!

# 一次性钱包私钥 (0x 开头)
PK=0xYOUR_THROWAWAY_PRIVATE_KEY

# 你在 Polymarket 的钱包地址(代理钱包地址; 官方 app 里能看到)
FUNDER=0xYOUR_POLYMARKET_ADDRESS

# 签名类型: 1=邮箱/magic 登录的代理钱包(最常见) | 2=浏览器钱包代理 | 0=普通 EOA 直连
# 不确定就先填 1, setup_auth.py 跑不通再换 2 或 0
SIG_TYPE=1

# CLOB API 凭证: 留空让 setup_auth.py 自动生成, 然后把它打印出来的值填回这里
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
