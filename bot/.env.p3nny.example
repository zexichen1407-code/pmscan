# Copy to .env and fill locally. Do not share this file.

# Throwaway wallet private key, 0x-prefixed.
PK=0xYOUR_THROWAWAY_PRIVATE_KEY

# Polymarket funder/deposit wallet address.
FUNDER=0xYOUR_POLYMARKET_FUNDER_ADDRESS

# 3 = POLY_1271 deposit wallet for new API users.
# 0 = plain EOA. Use the value matching your account type.
SIG_TYPE=3

# Optional. If empty, p3nny_taker_engine.py can derive and print them.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
